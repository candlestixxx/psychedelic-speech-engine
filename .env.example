# Copy to `.env` and fill in the values you need.

# DeepSeek API key (REQUIRED for the script-polishing step in app.py)
DEEPSEEK_API_KEY=

# Optional: DeepSeek model name (defaults to "deepseek-chat")
# DEEPSEEK_MODEL=deepseek-chat

# HuggingFace token (REQUIRED for speaker diarization). The pyannote
# diarization model is gated: create a token at huggingface.co/settings/tokens
# and ACCEPT THE TERMS on the model pages:
#   - https://huggingface.co/pyannote/speaker-diarization-community-1
#   - https://huggingface.co/pyannote/segmentation-3.0
HF_TOKEN=

# Suno API endpoint (only used by auto_run.py). Defaults to the common
# gcui/suno-api container on port 3000. Point this at whatever Docker
# image/port you are actually running.
# SUNO_API_URL=http://localhost:3000/api/custom_generate

# Suno request timeout in seconds (generation can be slow).
# SUNO_TIMEOUT=300

# espeak-ng is bundled automatically by the `espeakng-loader` pip package on
# Windows, so this is normally NOT needed. Only set it if you installed
# espeak-ng yourself and kokoro fails to find it.
# PHONEMIZER_ESPEAK_PATH=C:\path\to\espeak-ng.exe
