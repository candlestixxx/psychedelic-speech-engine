import os
import time
import requests
import argparse
import subprocess
from dotenv import load_dotenv

load_dotenv()

SUNO_API_URL = "http://localhost:3000/api/custom_generate"

def generate_suno_track(prompt_tags: str, title: str = "Goa Psytrance Track") -> str:
    """Sends a request to the local Suno API container and downloads the resulting MP3."""
    print(" [1/5] Requesting music generation from local Suno Docker API...")
    
    payload = {
        "prompt": "",
        "tags": prompt_tags,
        "title": title,
        "make_instrumental": True,
        "wait_audio": True  # Blocks until generation is complete
    }
    
    headers = {"Content-Type": "application/json"}
    
    try:
        response = requests.post(SUNO_API_URL, json=payload, headers=headers, timeout=120)
        response.raise_for_status()
        data = response.json()
        
        # Suno API returns an array of two generated tracks; pick the first
        track_info = data[0] if isinstance(data, list) else data
        audio_url = track_info.get("audio_url")
        
        if not audio_url:
            raise ValueError("Suno API did not return a valid audio_url.")
            
        print(f" [2/5] Music ready! Downloading track from {audio_url}...")
        audio_data = requests.get(audio_url).content
        
        local_music_file = f"suno_{int(time.time())}.mp3"
        with open(local_music_file, "wb") as f:
            f.write(audio_data)
            
        return local_music_file
        
    except Exception as e:
        print(f"❌ Failed to generate audio via local Suno API: {e}")
        raise

def run_pipeline(youtube_url: str, music_path: str, speaker: str, output: str):
    """Triggers the core app.py execution pipeline."""
    print("⚡ [3/5] Starting speech extraction, re-voicing, and video rendering...")
    
    cmd = [
        "python", "app.py",
        "--url", youtube_url,
        "--music", music_path,
        "--speaker", speaker,
        "--output", output
    ]
    subprocess.run(cmd, check=True)

def main():
    parser = argparse.ArgumentParser(description="Fully Automated Psychedelic Video Generator")
    parser.add_argument("--url", required=True, help="YouTube speech URL")
    parser.add_argument("--speaker", default="SPEAKER_01", help="Target speaker ID")
    parser.add_argument("--output", default="final_master.mp4", help="Output MP4 filename")
    parser.add_argument(
        "--tags", 
        default="psytrance, Goa trance, Ajja style, 145 bpm, rolling bassline, acid squelches, hypnotic tribal percussion, continuous groove, instrumental",
        help="Suno style tags"
    )
    
    args = parser.parse_args()
    
    # 1. Generate music automatically via local Suno container
    music_file = generate_suno_track(args.tags)
    
    # 2. Run the main processing and rendering workflow
    run_pipeline(args.url, music_file, args.speaker, args.output)
    
    print(f"\n🎉 Workflow complete! Final video saved to: {args.output}")

if __name__ == "__main__":
    main()
